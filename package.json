{
  "name": "moon-over-oakland",
  "version": "1.0.0",
  "description": "Automatically post moon phase updates for Oakland, CA to social media sites",
  "author": "DM Kishi <dm.kishi@gmail.com>",
  "keywords": [
    "moon",
    "oakland",
    "bluesky"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "post": "node src/index.ts",
    "preview": "DRY_RUN=true pnpm post",
    "horizons": "node scripts/nasaJplHorizons.ts",
    "check": "pnpm typecheck && pnpm test",
    "typecheck": "tsc",
    "test": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@atproto/api": "^0.13.35",
    "@js-temporal/polyfill": "^0.5.1",
    "dotenv": "^16.6.1",
    "liquidjs": "^10.27.2",
    "picocolors": "^1.1.1",
    "suncalc": "^1.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/suncalc": "^1.9.2",
    "husky": "^9.1.7",
    "strip-json-comments": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
