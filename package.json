{
  "name": "moon-over-oakland",
  "version": "1.0.0",
  "description": "Automatically post moon phase updates for Oakland, CA to social media sites",
  "author": "DM Kishi <dm.kishi@gmail.com>",
  "keywords": [
    "moon",
    "oakland",
    "bluesky"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "post": "node src/main.ts",
    "preview": "pnpm post --dry-run",
    "check": "pnpm typecheck && pnpm test",
    "horizons": "node scripts/nasaJplHorizons/main.ts",
    "typecheck": "tsc",
    "test": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@atproto/api": "^0.20.41",
    "@js-temporal/polyfill": "^0.5.1",
    "astronomia": "^4.2.0",
    "dotenv": "^17.4.2",
    "liquidjs": "^10.29.0",
    "picocolors": "^1.1.1",
    "suncalc": "^2.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "husky": "^9.1.7",
    "strip-json-comments": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
