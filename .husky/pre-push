#!/usr/bin/env bash
set -e

################################################################################
# Check version numbers
################################################################################
# Get version from `package.json`.
PACKAGE=v$(node -p "require('./package.json').version")

# Get first version number listed in `README.md`.
README=$(grep -oE '^### v([0-9]+\.){2}[0-9]+' README.md | head -n 1 | sed 's/^### //')

if [ "$PACKAGE" != "$README" ]; then
  echo 'Version mismatch detected:' >&2
  echo "  - package.json: $PACKAGE" >&2
  echo "  - README.md:    $README" >&2
  echo 'Please update all version references to match.' >&2
  exit 1
fi

################################################################################
# Check changelog date
################################################################################
if ! grep -qE "^### ${README} \([0-9]{4}-[0-9]{1,2}-[0-9]{1,2}\)" README.md; then
  echo 'WARNING: README.md - missing or invalid date in the Changelog.' >&2
fi

################################################################################
# Upload Git LFS objects
################################################################################
# Husky's `core.hooksPath` bypasses the hook that `git lfs install` would
# install, so call it here. It reads the pushed refs from stdin.
git lfs pre-push "$@"

