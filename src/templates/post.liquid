{% comment %}
  @param {string} phaseName - Moon phase name: new, first-quarter, full, third-quarter
  @param {string} phase - Moon phase value: 0-1, where 0 and 1 are new moon
  @param {number} illumination - Percent illuminated
  @param {number} age - Days into lunar cycle
  @param {number} distanceKm
  @param {Date} moonrise.date - Oakland moonrise time
  @param {number} moonrise.azimuthDeg - Azimuth at moonrise in degrees
  @param {Date} moonset.date - Oakland moonset time
  @param {number} moonset.azimuthDeg  - Azimuth at moonset in degrees
  @param {Date} nextNewMoon - Date of next new moon
  @param {Date} nextFullMoon - Date of next full moon
{% endcomment %}

{% liquid
  # E.g. "Thursday, January 1, 2026"
  assign DATE_FORMAT = "%A, %B %-d, %Y"

  # E.g. "1:30 PM"
  assign TIME_FORMAT = "%-l:%M %p"
%}

{% case phaseName %}
  {% when 'new' %}
    🌑 New Moon
  {% when 'first-quarter' %}
    🌓 Half Moon (First Quarter)
  {% when 'full' %}
    🌕 Full Moon
  {% when 'third-quarter' %}
    🌗 Half Moon (Third Quarter)
{% endcase %}

{% if moonrise %}Moonrise: {{ moonrise.date | date: TIME_FORMAT }}{% endif %}
{% if moonset %}Moonset: {{ moonset.date | date: TIME_FORMAT }}{% endif %}
