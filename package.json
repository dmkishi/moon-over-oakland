{
  "name": "moon-over-oakland",
  "version": "1.0.0",
  "description": "Automatically post moon phase updates for Oakland, CA to social media sites",
  "author": "DM Kishi <dm.kishi@gmail.com>",
  "keywords": [
    "moon",
    "oakland",
    "bluesky"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "tryPost": "node dist/index.js",
    "view:dev": "DRY_RUN=true tsx src/index.ts",
    "view:build": "DRY_RUN=true node dist/index.js"
  },
  "dependencies": {
    "@atproto/api": "^0.13.35",
    "dotenv": "^16.6.1",
    "liquidjs": "^10.25.0",
    "luxon": "^3.7.2",
    "picocolors": "^1.1.1",
    "suncalc": "^1.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@dmkishi/markdownlint-cli2.yaml": "^0.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.15",
    "@types/suncalc": "^1.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
