{
  "name": "moon-over-oakland",
  "version": "1.0.0",
  "author": "DM Kishi <dm.kishi@gmail.com>",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "config": {
    "image": "ghcr.io/dmkishi/moon-over-oakland"
  },
  "scripts": {
    "post": "node src/main.ts",
    "preview": "pnpm post --dry-run",
    "horizons": "node scripts/nasaJplHorizons/main.ts",
    "docker:build": "pnpm docker:build-only && pnpm docker:smoke-test",
    "docker:build-only": "docker build --pull --build-arg NODE_VERSION=$(cat .nvmrc) --tag $npm_package_config_image .",
    "docker:smoke-test": "pnpm docker:preview 2026-01-02",
    "docker:post": "docker run --rm --pull=always --env-file .env $npm_package_config_image",
    "docker:preview": "docker run --rm $npm_package_config_image --dry-run",
    "check": "pnpm typecheck && pnpm lint && vitest run",
    "typecheck": "tsc",
    "lint": "oxlint",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@atcute/atproto": "4.0.4",
    "@atcute/bluesky": "4.0.21",
    "@atcute/client": "5.1.2",
    "@atcute/password-session": "1.0.2",
    "@atcute/util-text": "1.3.4",
    "astronomia": "^4.2.0",
    "liquidjs": "^10.29.0",
    "picocolors": "^1.1.1",
    "suncalc": "^2.0.2"
  },
  "devDependencies": {
    "@dmkishi/oxlintrc": "^0.4.0",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "husky": "^9.1.7",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "strip-json-comments": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.0.0",
      "onFail": "error"
    }
  }
}
