{% comment %}
  @param {string} phaseType - 'new' | 'first-quarter' | 'full' | 'last-quarter'
  @param {string} eventDay - 'today' | 'tomorrow'
  @param {date} eventTime
  @param {date} moonrise
  @param {date} moonset
  @param {date} sunrise
  @param {date} sunset
  @param {number} deltaRiseMinutes
  @param {number} deltaSetMinutes
  @param {date} nextNew
  @param {date} nextFirstQuarter
  @param {date} nextFull
  @param {date} nextLastQuarter
{% endcomment %}

{% liquid
  # E.g. "September 18 (Thu)"
  assign DATE_FORMAT = "%B %-d (%a)"
  assign nextNewDate = nextNew | date: DATE_FORMAT
  assign nextFirstQuarterDate = nextFirstQuarter | date: DATE_FORMAT
  assign nextFullDate = nextFull | date: DATE_FORMAT
  assign nextLastQuarterDate = nextLastQuarter | date: DATE_FORMAT

  # E.g. "1:30 PM"
  assign TIME_FORMAT = "%-l:%M %p"
  assign moonrise_time = moonrise | date: TIME_FORMAT
  assign moonset_time = moonset | date: TIME_FORMAT

  if deltaRiseMinutes < -45
    assign rise_verb = 'before'
  elsif deltaRiseMinutes < -20
    assign rise_verb = 'shortly before'
  elsif deltaRiseMinutes < 15
    assign rise_verb = 'together with'
  elsif deltaRiseMinutes > 15
    assign rise_verb = 'shortly after'
  else
    assign rise_verb = 'after'
  endif

  if deltaSetMinutes < -45
    assign set_verb = 'after'
  elsif deltaSetMinutes < -20
    assign set_verb = 'shortly after'
  elsif deltaSetMinutes < 15
    assign set_verb = 'together'
  elsif deltaSetMinutes > 15
    assign set_verb = 'shortly before'
  else
    assign set_verb = 'before'
  endif
%}

{% case phaseType %}
  {% when 'new' %}
    🌑 New Moon

    It is a new moon today. It will rise {{ rise_verb }} the sun at {{ moonrise_time }} and set {{ set_verb }} at {{ moonset_time }}. You can't see it but the Moon will be in the sky all day.

    Next Phases:
    - Half Moon: {{ nextFirstQuarterDate }}
    - Full Moon: {{ nextFullDate }}

  {% when 'first-quarter' %}
    🌓 Half Moon (First Quarter)

    It is a half moon today. The Moon will rise near noon at {{ moonrise_time }} and set near midnight at {{ moonset_time }}. Look for it high in the southern sky at dusk.

    Next Phases:
    - Full Moon: {{ nextFullDate }}
    - Half Moon: {{ nextLastQuarterDate }}

  {% when 'full' %}
    🌕 Full Moon

    It is a full moon today. It will rise around sunset at {{ moonrise_time }} and set tomorrow morning around sunrise at {{ moonset_time }}.

    Coming soon:
    - Half moon: {{ nextLastQuarterDate }}
    - New moon: {{ nextNewDate }}
    - Full moon: {{ nextFullDate }}

  {% when 'last-quarter' %}
    🌗 Half Moon (Last Quarter)

    It is a half moon today. Rising around midnight and setting tomorrow around noon. Look for it in the southern sky at dawn.

    Next Phases:
    - New Moon: {{ nextNewDate }}
    - Half Moon: {{ nextFirstQuarterDate }}
    - Full Moon: {{ nextFullDate }}

{% endcase %}
