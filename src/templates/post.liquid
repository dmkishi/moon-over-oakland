{% comment %}
  @param {MoonPost.*} - See `src/moonPost.ts`.
{% endcomment %}

{% liquid
  # E.g. "Thursday, January 1, 2026"
  assign DATE_FORMAT = "%A, %B %-d, %Y"

  # E.g. "1:30 PM"
  assign TIME_FORMAT = "%-l:%M %p"
%}

{% capture moonrise_moonset %}
  Moonrise: {{ moonRise.date | date: TIME_FORMAT }}
  Moonset: {{ moonSet.date | date: TIME_FORMAT }}
{% endcapture %}

{% case phase %}
  {% when 'new' %}
    🌑 New Moon

    It is a New Moon today. The moon will rise and set nearly in tandem with the
    sun. You can't see it but the moon will be in the sky all day long.

    {{ moonrise_moonset }}
    Next Half Moon:
    Next Full Moon:
  {% when 'first-quarter' %}
    🌓 Half Moon (First Quarter)

    {{ moonrise_moonset }}
    Next Full Moon:
    Next Half Moon:
  {% when 'full' %}
    🌕 Full Moon

    It is a Full Moon tonight. The moon will rise around sunset and, on the next
    day, set around sunrise.

    {{ moonrise_moonset }}
    Next Half Moon:
    Next New Moon:
  {% when 'third-quarter' %}
    🌗 Half Moon (Last Quarter)

    {{ moonrise_moonset }}
    Next Half Moon:
    Next Full Moon:
{% endcase %}
