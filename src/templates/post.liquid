{% comment %}
  @param {MoonDay.*} - See `src/moonDay.ts`.
{% endcomment %}

{% liquid
  # E.g. "Thursday, January 1, 2026"
  assign DATE_FORMAT = "%A, %B %-d, %Y"

  # E.g. "1:30 PM"
  assign TIME_FORMAT = "%-l:%M %p"
%}

{% case average.phaseName %}
  {% when 'new' %}
    🌑 New Moon
  {% when 'first-quarter' %}
    🌓 Half Moon (First Quarter)
  {% when 'full' %}
    🌕 Full Moon
  {% when 'third-quarter' %}
    🌗 Half Moon (Third Quarter)
{% endcase %}

Moonrise: {{ moonrise.date | date: TIME_FORMAT }}
Moonset: {{ moonset.date | date: TIME_FORMAT }}
