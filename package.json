{
  "name": "moon-over-oakland",
  "version": "0.0.0",
  "author": "DM Kishi <dm.kishi@gmail.com>",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "post": "node src/main.ts",
    "post:test": "pnpm post --test",
    "preview": "pnpm post --dry-run",
    "posts-pdf": "node scripts/posts-pdf/main.ts",
    "horizons": "node scripts/nasaJplHorizons/main.ts",
    "check": "pnpm typecheck && pnpm lint && vitest run",
    "typecheck": "tsc",
    "lint": "oxlint",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "generate-moon-assets": "node scripts/generate-moon-assets.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@atcute/atproto": "4.0.5",
    "@atcute/bluesky": "4.0.27",
    "@atcute/client": "5.1.2",
    "@atcute/password-session": "1.0.2",
    "@atcute/util-text": "1.3.4",
    "astronomia": "^4.3.0",
    "picocolors": "^1.1.1",
    "sharp": "^0.35.5",
    "suncalc": "^2.1.4"
  },
  "devDependencies": {
    "@dmkishi/oxlintrc": "^0.4.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "strip-json-comments": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.0.0",
      "onFail": "error"
    }
  }
