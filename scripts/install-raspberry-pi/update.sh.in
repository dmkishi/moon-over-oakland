#!/bin/sh
#
# DO NOT EDIT. Written by install-raspberry-pi.sh, which overwrites this file on
# every run. Re-run it to change the image.
#
# Usage: update.sh [sha-<short>]
#
# Re-runs the latest installer. Defaults to the newest image.

set -eu

INSTALLER_URL='@INSTALLER_URL@'

installer=$(curl -fsSL "$INSTALLER_URL")
printf '%s\n' "$installer" | INSTALLER_URL=$INSTALLER_URL sh -s -- "$@"
