/**
 * JPL Horizons reference data for `day-events.test.ts`. See the test file for
 * more information.
 *
 * Fixture covers:
 * - All four principal phases.
 * - Both daylight saving transitions and the day before each, giving the
 *   23-hour day 2026-03-08 and the 25-hour day 2026-11-01.
 * - A leap year day.
 * - A null moonrise (2026-03-08) and a null moonset (2026-01-25), where the
 *   paired event falls outside the civil day.
 *
 * Keep fixtures to a single calendar year outside of specific cross-year cases,
 * such as leap years, etc.
 *
 * Run `pnpm horizons YYYY-MM-DD` to generate additional fixtures.
 */
[
  {
    "description": "2024: Leap year day",
    "day": "2024-02-29",
    "events": {
      "moonrise": { "dateTime": "2024-02-29T23:15:00-08:00" },
      "moonset": { "dateTime": "2024-02-29T09:00:00-08:00" },
      "sunrise": { "dateTime": "2024-02-29T06:41:00-08:00" },
      "sunset": { "dateTime": "2024-02-29T18:04:00-08:00" }
    }
  },
  {
    "description": "2026: First day of the year",
    "day": "2026-01-01",
    "events": {
      "moonrise": { "dateTime": "2026-01-01T15:05:00-08:00" },
      "moonset": { "dateTime": "2026-01-01T05:55:00-08:00" },
      "sunrise": { "dateTime": "2026-01-01T07:24:00-08:00" },
      "sunset": { "dateTime": "2026-01-01T17:02:00-08:00" }
    }
  },
  {
    "description": "2026: Daylight saving time (before spring forward)",
    "day": "2026-03-07",
    "events": {
      "moonrise": { "dateTime": "2026-03-07T22:51:00-08:00" },
      "moonset": { "dateTime": "2026-03-07T08:20:00-08:00" },
      "sunrise": { "dateTime": "2026-03-07T06:31:00-08:00" },
      "sunset": { "dateTime": "2026-03-07T18:10:00-08:00" }
    }
  },
  {
    "description": "2026: Daylight saving time (after spring forward)",
    "day": "2026-03-08",
    "events": {
      "moonrise": null,
      "moonset": { "dateTime": "2026-03-08T09:50:00-07:00" },
      "sunrise": { "dateTime": "2026-03-08T07:30:00-07:00" },
      "sunset": { "dateTime": "2026-03-08T19:11:00-07:00" }
    }
  },
  {
    "description": "2026: Standard time (before fall back)",
    "day": "2026-10-31",
    "events": {
      "moonrise": { "dateTime": "2026-10-31T23:30:00-07:00" },
      "moonset": { "dateTime": "2026-10-31T13:40:00-07:00" },
