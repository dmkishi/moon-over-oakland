{% comment %}
  @param {MoonDay.*} - See `src/moonDay.ts`.
{% endcomment %}

{%- liquid
  # E.g. "Wed, 3/11/2026, 2:30 PM"
  assign DATETIME_FORMAT = "%a, %-m/%-d/%Y, %-l:%M %p"

  # E.g. "Wed, 3/11/2026"
  assign DATE_FORMAT = "%a, %-m/%-d/%Y"

  # E.g. "3/11/2026"
  assign DATE_FORMAT_SHORT = "%-m/%-d/%Y"

  # E.g. "2:30 PM"
  assign TIME_FORMAT = "%-l:%M %p"
-%}

Day:            {{ day | date: DATE_FORMAT }}
Average:
  Phase Name:   {{ average.phaseName }}
  Phase:        {{ average.phase }}
  Illumination: {{ average.illumination | times: 100 | round }}%
  Age:          {{ average.age }} days
  Distance:     {{ average.distanceKm | localeString }} km
Moonrise:       {{ moonrise.date | date: DATETIME_FORMAT }} ({{ moonrise.compassDirection }}, {{ moonrise.compassDeg | round }}°, Tilt: {{ moonrise.tiltDeg | round }}°)
Moonset:        {{ moonset.date | date: DATETIME_FORMAT }} ({{ moonset.compassDirection }}, {{ moonset.compassDeg | round }}°, Tilt: {{ moonset.tiltDeg | round }}°)
Sunrise:        {{ sunrise.date | date: TIME_FORMAT }} ({{ sunrise.compassDirection }}, {{ sunrise.compassDeg | round }}°)
Sunset:         {{ sunset.date | date: TIME_FORMAT }} ({{ sunset.compassDirection }}, {{ sunset.compassDeg | round }}°)
Next New Moon:  {{ nextNewMoon | daysAway }} days ({{ nextNewMoon | date: DATE_FORMAT_SHORT }})
Next Full Moon: {{ nextFullMoon | daysAway }} days ({{ nextFullMoon | date: DATE_FORMAT_SHORT }})
