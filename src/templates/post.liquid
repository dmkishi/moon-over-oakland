{% doc %}
  @param {string} phase - Moon phase name: new, first-quarter, full, third-quarter
  @param {number} illumination - Percent illuminated
  @param {number} age - Days into lunar cycle
  @param {number} distance - Distance in km
  @param {Date} moonrise - Local moonrise time
  @param {Date} moonset - Local moonset time
  @param {Date} nextNewMoon - Date of next new moon
  @param {Date} nextFullMoon - Date of next full moon
  @param {Date} date - Current date
{% enddoc %}

{% liquid
  # E.g. "Thursday, January 1, 2026"
  assign DATE_FORMAT = "%A, %B %-d, %Y"

  # E.g. "1:30 PM"
  assign TIME_FORMAT = "%-l:%M %p"
%}

{% case phase %}
  {% when 'new' %}
    🌑 New Moon
  {% when 'first-quarter' %}
    🌓 First Quarter
  {% when 'full' %}
    🌕 Full Moon
  {% when 'third-quarter' %}
    🌗 Third Quarter
{% endcase %}

{{ date | date: DATE_FORMAT }}
{% if moonrise %}Moonrise: {{ moonrise | date: TIME_FORMAT }}{% endif %}
{% if moonset %}Moonset: {{ moonset | date: TIME_FORMAT }}{% endif %}
