{% comment %}
  @param {string} phaseType - 'new' | 'first-quarter' | 'full' | 'last-quarter'
  @param {string} eventDay - 'today' | 'tomorrow'
  @param {date} eventTime
  @param {date} moonrise
  @param {date} moonset
  @param {date} sunrise
  @param {date} sunset
  @param {number} deltaRiseMinutes
  @param {number} deltaSetMinutes
  @param {date} nextNew
  @param {date} nextFirstQuarter
  @param {date} nextFull
  @param {date} nextLastQuarter
{% endcomment %}

{% liquid
  # E.g. "1:30 pm", "12-noon", "12-midnight"
  assign TIME_FORMAT = "%-l:%M %P"
  assign moonrise_time = moonrise | date: TIME_FORMAT | replace: "12:00 am", "12-midnight" | replace: "12:00 pm", "12-noon"
  assign moonset_time = moonset | date: TIME_FORMAT | replace: "12:00 am", "12-midnight" | replace: "12:00 pm", "12-noon"

  # E.g. "9/18 (Thu)"
  assign DATE_FORMAT = "%-m/%-d (%a)"
  assign nextNewDate = nextNew | date: DATE_FORMAT
  assign nextFirstQuarterDate = nextFirstQuarter | date: DATE_FORMAT
  assign nextFullDate = nextFull | date: DATE_FORMAT
  assign nextLastQuarterDate = nextLastQuarter | date: DATE_FORMAT
%}

{% case phaseType %}
  {% when 'new' %}
    {% liquid
      # ------------------------------------------------------------------------
      # NEW
      # - MOONRISE around sunrise.
      # - MOONSET around sunset.
    %}

    🌑 The NEW MOON rises with the sun and sets with the sun. It’ll be in the sky all day, though you probably won’t be able to see it.

    • Moonrise: {{ moonrise_time }}
    • Moonset: {{ moonset_time }}

    Next phases:
    • Half Moon: {{ nextFirstQuarterDate }}
    • Full Moon: {{ nextFullDate }}
    • New Moon: {{ nextNewDate }}

  {% when 'first-quarter' %}
    {% liquid
      # ------------------------------------------------------------------------
      # FIRST QUARTER
      # - MOONRISE around noon.
      # - MOONSET around midnight at end of day (notate if after midnight.)
      if deltaSetMinutes > 0
        assign moonset_note = "(after midnight)"
      endif
    %}

    🌓 The HALF MOON (FIRST QUARTER) rises around noon and sets around midnight. It is visible in the afternoon and evening.

    • Moonrise: {{ moonrise_time }}
    • Moonset: {{ moonset_time }} {{ moonset_note }}

    Next phases:
    • Full Moon: {{ nextFullDate }}
    • Half Moon: {{ nextLastQuarterDate }}
    • New Moon: {{ nextNewDate }}

  {% when 'full' %}
    {% liquid
      # ------------------------------------------------------------------------
      # FULL
      # - MOONRISE around sunset.
      # - MOONSET around sunrise (always the next morning.)
    %}

    🌕 The FULL MOON rises around sunset and sets around sunrise. It’ll be visible all night, given a clear sky.

    • Moonrise: {{ moonrise_time }}
    • Moonset: {{ moonset_time }} (tomorrow morning)

    Next phases:
    • Half Moon: {{ nextLastQuarterDate }}
    • New Moon: {{ nextNewDate }}
    • Full Moon: {{ nextFullDate }}

  {% when 'last-quarter' %}
    {% liquid
      # ------------------------------------------------------------------------
      # LAST QUARTER
      # - MOONRISE around midnight at start of day (notate if before midnight.)
      # - MOONSET around noon.
      if deltaRiseMinutes < 0
        assign moonrise_note = "(yesterday)"
      endif
    %}

    🌗 The HALF MOON (LAST QUARTER) rises around midnight and sets around noon today. It is visible in the late night and morning.

    • Moonrise: {{ moonrise_time }} {{ moonrise_note }}
    • Moonset: {{ moonset_time }}

    Next phases:
    • New Moon: {{ nextNewDate }}
    • Half Moon: {{ nextFirstQuarterDate }}
    • Full Moon: {{ nextFullDate }}

{% endcase %}
