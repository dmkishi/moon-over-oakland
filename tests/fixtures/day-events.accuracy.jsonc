      "sunset": { "dateTime": "2026-10-31T18:12:00-07:00" }
    }
  },
  {
    "description": "2026: Standard time (after fall back)",
    "day": "2026-11-01",
    "events": {
      "moonrise": { "dateTime": "2026-11-01T23:43:00-08:00" },
      "moonset": { "dateTime": "2026-11-01T13:19:00-08:00" },
      "sunrise": { "dateTime": "2026-11-01T06:34:00-08:00" },
      "sunset": { "dateTime": "2026-11-01T17:11:00-08:00" }
    }
  },
  {
    "description": "2026: Principal phase event day (new moon)",
    "day": "2026-01-18",
    "events": {
      "moonrise": { "dateTime": "2026-01-18T07:36:00-08:00" },
